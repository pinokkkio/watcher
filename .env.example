# Скопируйте в .env (он в .gitignore) и заполните.

# Бот от @BotFather и чат, куда слать уведомления (для канала — -100…)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# HTTPS-прокси только для запросов к api.telegram.org.
# https://host:port — TLS до прокси; http://host:port — обычный CONNECT-прокси.
TELEGRAM_PROXY=https://proxy.example.com:3128
TELEGRAM_PROXY_USER=
TELEGRAM_PROXY_PASSWORD=
# Только если сертификат https-прокси самоподписанный (см. volumes в docker-compose.yml)
# TELEGRAM_PROXY_CA=/app/certs/proxy-ca.pem

# Необязательно: какие рынки смотреть (перекрывает config.toml)
# WATCH_MARKETS=shares,ofz,corp_bonds,futures

# Необязательно: MOEX Passport (данные без задержки при наличии подписки)
# ISS_LOGIN=
# ISS_PASSWORD=
